# Spring profile
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
POSTGRES_DB=rpgspace
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/rpgspace
DATABASE_USERNAME=rpgspace
DATABASE_PASSWORD=change-this-password

# Reserved for the authentication stage. Use a Base64-encoded secret with at least 256 bits.
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-256-bits
JWT_EXPIRATION=900000
